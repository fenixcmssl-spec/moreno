# ==============================================================================
# FENIXCMS SaaS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to /var/www/fenixcms/.env on your VPS and fill with actual production secrets.
# DO NOT COMMIT REAL SECRETS TO GIT.
# ==============================================================================

# Node Environment (Must be strictly 'production')
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# Canonical SaaS Platform URL (without trailing slash)
APP_URL=https://fenixcms.com
NEXT_PUBLIC_APP_URL=https://fenixcms.com
BASE_DOMAIN=fenixcms.com

# PostgreSQL Production Connection String
# Format: postgresql://<user>:<password>@localhost:5432/<dbname>?schema=public
DATABASE_URL=postgresql://fenix_db_user:YOUR_STRONG_POSTGRES_PASSWORD@localhost:5432/fenixcms_prod?schema=public

# Super Admin Initial Bootstrap Credentials (Executed during first deploy)
INITIAL_ADMIN_EMAIL=admin@fenixcms.com
INITIAL_ADMIN_PASSWORD=YOUR_STRONG_INITIAL_ADMIN_PASSWORD
INITIAL_ADMIN_NAME="Fenix Super Admin"

# JWT and Session Security (Generate with: openssl rand -base64 32)
JWT_SECRET=YOUR_64_CHAR_HEX_OR_BASE64_JWT_SECRET
SESSION_SECRET=YOUR_64_CHAR_HEX_OR_BASE64_SESSION_SECRET

# Stripe Payment Gateway (Live or Test Keys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# PayPal Payment Gateway (Live or Sandbox Keys)
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID
PAYPAL_MODE=live

# System Isolation & Zero-Fallback Flag
FAIL_CLOSED_ON_DB_ERROR=true
ALLOW_DEMO_SEED=false
ENABLE_DEV_FALLBACKS=false

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Storage / Upload Configuration
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/var/www/fenixcms/public/uploads
MAX_FILE_SIZE_MB=50

# Backup Configuration
BACKUP_DIR=/var/backups/fenixcms
BACKUP_RETENTION_DAYS=30
