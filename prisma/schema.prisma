// Proyecto Corporación Fénix - Esquema de Base de Datos PostgreSQL Multi-Tenant
// Generado de acuerdo a las especificaciones técnicas del Documento de Implementación

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. USUARIOS, AUTENTICACIÓN Y ROLES (RBAC)
// -------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  TENANT_OWNER
  TENANT_ADMIN
  EDITOR
  CUSTOMER
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
  EXPIRED
  ARCHIVED
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String
  passwordHash  String
  avatarUrl     String?
  role          UserRole     @default(CUSTOMER)
  status        EntityStatus @default(ACTIVE)
  emailVerified DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships   Membership[]
  sessions      Session[]
  auditLogs     AuditLog[]
  ownedTenants  Tenant[]     @relation("TenantOwner")
  orders        Order[]
  posts         Post[]
  reviews       Review[]
  classifieds   ClassifiedAd[]
  favorites     Favorite[]
  messagesSent  Message[]    @relation("SenderMessages")
  messagesReceived Message[] @relation("ReceiverMessages")

  @@index([email])
  @@index([role])
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  tenantId  String
  role      UserRole     @default(TENANT_ADMIN)
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  userEmail String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 2. MULTI-TENANCY & DOMINIOS
// -------------------------------------------------------------

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  status      EntityStatus @default(ACTIVE)
  ownerId     String
  logoUrl     String?
  faviconUrl  String?
  branding    Json?        // Colores primarios, secundarios, tipografías, css
  locale      String       @default("es")
  timezone    String       @default("Europe/Madrid")
  currency    String       @default("EUR")
  settings    Json?        // Ajustes específicos del tenant
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  owner               User                 @relation("TenantOwner", fields: [ownerId], references: [id])
  domains             Domain[]
  memberships         Membership[]
  licenses            License[]
  subscriptions       Subscription[]
  payments            Payment[]
  pluginInstallations PluginInstallation[]
  themeInstallations  ThemeInstallation[]
  media               Media[]
  pages               Page[]
  menus               Menu[]
  products            Product[]
  categories          Category[]
  orders              Order[]
  coupons             Coupon[]
  posts               Post[]
  postCategories      PostCategory[]
  tags                Tag[]
  classifieds         ClassifiedAd[]
  classifiedCategories ClassifiedCategory[]
  auditLogs           AuditLog[]

  @@index([slug])
  @@index([status])
}

model Domain {
  id        String       @id @default(cuid())
  tenantId  String
  hostname  String       @unique
  type      String       @default("custom") // "subdomain" | "custom"
  verified  Boolean      @default(false)
  primary   Boolean      @default(false)
  sslStatus String       @default("active")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([hostname])
}

// -------------------------------------------------------------
// 3. SISTEMA DE APLICACIONES, PLANES Y ENTITLEMENTS
// -------------------------------------------------------------

model Application {
  id             String       @id @default(cuid())
  key            String       @unique // "ECOMMERCE", "BLOG", "CLASSIFIEDS", "LANDING", "BOOKING", "LMS"
  name           String
  slug           String       @unique
  description    String
  status         EntityStatus @default(ACTIVE)
  icon           String
  version        String       @default("1.0.0")
  settingsSchema Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  modules       ApplicationModule[]
  plans         Plan[]
  licenses      License[]
  subscriptions Subscription[]

  @@index([key])
  @@index([status])
}

model ApplicationModule {
  id            String      @id @default(cuid())
  applicationId String
  key           String      // "products", "orders", "posts", "ads", "bookings"
  name          String
  description   String?
  isDefault     Boolean     @default(true)
  createdAt     DateTime    @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, key])
  @@index([applicationId])
}

model Plan {
  id            String       @id @default(cuid())
  applicationId String
  name          String
  slug          String       @unique
  badge         String?
  description   String
  monthlyPrice  Decimal      @db.Decimal(10, 2)
  yearlyPrice   Decimal      @db.Decimal(10, 2)
  status        EntityStatus @default(ACTIVE)
  popular       Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  entitlements  Entitlement[]
  licenses      License[]
  subscriptions Subscription[]

  @@index([applicationId])
  @@index([slug])
}

model Entitlement {
  id         String   @id @default(cuid())
  planId     String
  featureKey String   // "products.max", "storage.max_mb", "domains.max", "ai.enabled"
  valueJson  Json     // Valor tipado: número, boolean, array de permisos
  createdAt  DateTime @default(now())

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([planId])
}

// -------------------------------------------------------------
// 4. LICENCIAS, SUSCRIPCIONES Y PAGOS
// -------------------------------------------------------------

enum LicenseStatus {
  ACTIVE
  PENDING
  SUSPENDED
  EXPIRED
  CANCELLED
}

model License {
  id            String        @id @default(cuid())
  tenantId      String
  applicationId String
  planId        String
  licenseKey    String        @unique
  status        LicenseStatus @default(ACTIVE)
  validFrom     DateTime      @default(now())
  validTo       DateTime
  autoRenew     Boolean       @default(true)
  customerName  String
  customerEmail String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([applicationId])
  @@index([licenseKey])
  @@index([status])
}

model Subscription {
  id                     String       @id @default(cuid())
  tenantId               String
  applicationId          String
  planId                 String
  provider               String       // "paypal" | "stripe" | "manual"
  providerSubscriptionId String?      @unique
  status                 EntityStatus @default(ACTIVE)
  billingPeriod          String       @default("monthly") // "monthly" | "yearly"
  currentPeriodStart     DateTime     @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  plan        Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  payments    Payment[]

  @@index([tenantId])
  @@index([applicationId])
}

model Payment {
  id                String       @id @default(cuid())
  tenantId          String
  subscriptionId    String?
  provider          String       // "paypal", "stripe", "bizum", "redsys"
  providerPaymentId String       @unique
  amount            Decimal      @db.Decimal(10, 2)
  currency          String       @default("EUR")
  status            String       // "PAID", "PENDING", "FAILED", "REFUNDED"
  payerEmail        String?
  payerName         String?
  details           Json?
  paidAt            DateTime?
  createdAt         DateTime     @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([providerPaymentId])
}

// -------------------------------------------------------------
// 5. MEDIATECA & BRANDING
// -------------------------------------------------------------

model Media {
  id         String   @id @default(cuid())
  tenantId   String
  filename   String
  storageKey String
  url        String
  mimeType   String
  size       Int
  width      Int?
  height     Int?
  alt        String?
  checksum   String?
  createdBy  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// -------------------------------------------------------------
// 6. CMS CORE: PÁGINAS, MENÚS Y CONTENIDO COMÚN
// -------------------------------------------------------------

model Page {
  id             String       @id @default(cuid())
  tenantId       String
  slug           String
  title          String
  content        String       @db.Text
  status         EntityStatus @default(ACTIVE)
  isHomepage     Boolean      @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Menu {
  id        String     @id @default(cuid())
  tenantId  String
  name      String
  location  String     // "header", "footer", "sidebar"
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@index([tenantId])
}

model MenuItem {
  id        String  @id @default(cuid())
  menuId    String
  title     String
  url       String
  order     Int     @default(0)
  target    String? @default("_self")
  parentId  String?

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuSubItems", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuSubItems")

  @@index([menuId])
}

// -------------------------------------------------------------
// 7. MÓDULO E-COMMERCE
// -------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  imageUrl    String?
  parentId    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Product {
  id             String       @id @default(cuid())
  tenantId       String
  categoryId     String?
  title          String
  slug           String
  description    String       @db.Text
  price          Decimal      @db.Decimal(10, 2)
  compareAtPrice Decimal?     @db.Decimal(10, 2)
  costPrice      Decimal?     @db.Decimal(10, 2)
  sku            String
  barcode        String?
  stock          Int          @default(0)
  images         Json         // Array de URLs de imágenes
  rating         Decimal      @default(5.0) @db.Decimal(3, 2)
  reviewsCount   Int          @default(0)
  isFeatured     Boolean      @default(false)
  isBestSeller   Boolean      @default(false)
  isDeal         Boolean      @default(false)
  discountPct    Int?
  tags           Json?        // Array de tags
  attributes     Json?        // Marca, color, talla, peso
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  orderItems OrderItem[]
  reviews    Review[]

  @@unique([tenantId, slug])
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([categoryId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  title     String   // ej. "Rojo / XL"
  sku       String
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  options   Json     // { color: "Rojo", size: "XL" }
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id              String      @id @default(cuid())
  tenantId        String
  userId          String?
  orderNumber     String      @unique
  status          OrderStatus @default(PENDING)
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress Json        // Dirección, ciudad, código postal, país
  paymentMethod   String      // "paypal", "stripe", "bizum", "redsys", "cod"
  paymentStatus   String      @default("PENDING")
  subtotal        Decimal     @db.Decimal(10, 2)
  taxAmount       Decimal     @db.Decimal(10, 2)
  shippingCost    Decimal     @db.Decimal(10, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  trackingNumber  String?     // Código Correos Express
  carrier         String?     @default("Correos Express")
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items  OrderItem[]

  @@index([tenantId])
  @@index([orderNumber])
  @@index([status])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String?
  productTitle   String
  sku            String
  quantity       Int
  unitPrice      Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)
  productImage   String?
  selectedVariant String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Coupon {
  id            String       @id @default(cuid())
  tenantId      String
  code          String
  discountType  String       // "PERCENTAGE" | "FIXED_AMOUNT"
  discountValue Decimal      @db.Decimal(10, 2)
  minSpend      Decimal?     @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int          @default(0)
  validFrom     DateTime     @default(now())
  validTo       DateTime?
  status        EntityStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  userName  String
  userEmail String
  rating    Int      @default(5)
  title     String?
  comment   String   @db.Text
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
}

// -------------------------------------------------------------
// 8. MÓDULO BLOG / NOTICIAS
// -------------------------------------------------------------

enum PostStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

model PostCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posts  Post[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Tag {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posts  Post[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Post {
  id             String     @id @default(cuid())
  tenantId       String
  categoryId     String?
  authorId       String
  title          String
  slug           String
  excerpt        String?    @db.Text
  content        String     @db.Text
  featuredImage  String?
  status         PostStatus @default(PUBLISHED)
  publishedAt    DateTime   @default(now())
  seoTitle       String?
  seoDescription String?
  viewsCount     Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags     Tag[]
  comments Comment[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([status])
}

model Comment {
  id        String       @id @default(cuid())
  postId    String
  authorName String
  authorEmail String
  content   String       @db.Text
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// -------------------------------------------------------------
// 9. MÓDULO CLASIFICADOS / ANUNCIOS
// -------------------------------------------------------------

enum AdStatus {
  DRAFT
  PENDING
  PUBLISHED
  SOLD
  EXPIRED
  REJECTED
}

model ClassifiedCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  icon        String?
  createdAt   DateTime @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ads    ClassifiedAd[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model ClassifiedAd {
  id          String             @id @default(cuid())
  tenantId    String
  categoryId  String
  sellerId    String
  title       String
  slug        String
  description String             @db.Text
  price       Decimal            @db.Decimal(10, 2)
  location    String             // Ciudad, Provincia
  images      Json               // Array de imágenes
  status      AdStatus           @default(PUBLISHED)
  featured    Boolean            @default(false)
  phone       String?
  contactEmail String?
  attributes  Json?              // ej. Kilómetros, Año, Estado
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category  ClassifiedCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  seller    User               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  favorites Favorite[]
  messages  Message[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([status])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  adId      String
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ad   ClassifiedAd @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([userId, adId])
}

model Message {
  id         String   @id @default(cuid())
  adId       String
  senderId   String
  receiverId String
  content    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  ad       ClassifiedAd @relation(fields: [adId], references: [id], onDelete: Cascade)
  sender   User         @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User         @relation("ReceiverMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([adId])
  @@index([senderId])
  @@index([receiverId])
}

// -------------------------------------------------------------
// 10. SISTEMA DE PLUGINS ESTILO WORDPRESS
// -------------------------------------------------------------

model Plugin {
  id               String       @id @default(cuid())
  key              String       @unique // "plugin_correos_pro", "plugin_stripe_connect"
  name             String
  slug             String       @unique
  description      String
  author           String
  version          String       @default("1.0.0")
  status           EntityStatus @default(ACTIVE)
  applicationScope String       @default("ALL") // "ECOMMERCE", "BLOG", "ALL"
  manifest         Json         // Hooks, dependencias, settingsSchema, permisos
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  versions      PluginVersion[]
  installations PluginInstallation[]

  @@index([key])
  @@index([status])
}

model PluginVersion {
  id            String   @id @default(cuid())
  pluginId      String
  version       String
  packageUrl    String?
  checksum      String?
  changelog     String?
  minCmsVersion String   @default("1.0.0")
  publishedAt   DateTime @default(now())

  plugin        Plugin               @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  installations PluginInstallation[]

  @@unique([pluginId, version])
}

model PluginInstallation {
  id        String       @id @default(cuid())
  tenantId  String
  pluginId  String
  versionId String?
  status    EntityStatus @default(ACTIVE)
  config    Json?        // Configuración específica del tenant
  enabledAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plugin  Plugin         @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  version PluginVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, pluginId])
  @@index([tenantId])
}

// -------------------------------------------------------------
// 11. SISTEMA DE TEMAS Y THEME BUILDER
// -------------------------------------------------------------

model Theme {
  id               String       @id @default(cuid())
  key              String       @unique
  name             String
  slug             String       @unique
  description      String
  author           String
  version          String       @default("1.0.0")
  applicationScope String       @default("ALL")
  status           EntityStatus @default(ACTIVE)
  manifest         Json         // Sections, palette, fonts, schema
  previewUrl       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  versions      ThemeVersion[]
  installations ThemeInstallation[]

  @@index([key])
}

model ThemeVersion {
  id          String   @id @default(cuid())
  themeId     String
  version     String
  packageUrl  String?
  changelog   String?
  publishedAt DateTime @default(now())

  theme         Theme               @relation(fields: [themeId], references: [id], onDelete: Cascade)
  installations ThemeInstallation[]

  @@unique([themeId, version])
}

model ThemeInstallation {
  id        String       @id @default(cuid())
  tenantId  String
  themeId   String
  versionId String?
  active    Boolean      @default(false)
  status    EntityStatus @default(ACTIVE)
  config    Json?        // Bloques visuales, secciones personalizadas, tipografías
  updatedAt DateTime     @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  theme   Theme         @relation(fields: [themeId], references: [id], onDelete: Cascade)
  version ThemeVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, themeId])
  @@index([tenantId])
}
