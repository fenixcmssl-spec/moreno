# =========================================================================
# FENIXCMS SAAS — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE (.env.example)
# =========================================================================

# -------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME & SERVER
# -------------------------------------------------------------------------
# [Private, Mandatory, Production/Development]
NODE_ENV=production
PORT=3000
APP_URL=https://fenixcms.com
SECRET_KEY=generate_a_secure_random_secret_32_chars

# -------------------------------------------------------------------------
# 2. PERSISTENCE & DATABASE (POSTGRESQL + PRISMA)
# -------------------------------------------------------------------------
# [Private, Mandatory in Production]
DATABASE_URL=postgresql://fenix_user:YOUR_PASSWORD@localhost:5432/fenixcms_prod?schema=public

# -------------------------------------------------------------------------
# 3. AI CAPABILITIES (GOOGLE GEMINI API)
# -------------------------------------------------------------------------
# [Private, Optional / Server-Side Gemini Features]
GEMINI_API_KEY=

# -------------------------------------------------------------------------
# 4. PAYMENT GATEWAY: PAYPAL REST API (SERVER-SIDE ONLY)
# -------------------------------------------------------------------------
# [Private, Mandatory for SaaS & Storefront Payments]
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# -------------------------------------------------------------------------
# 5. PAYMENT GATEWAY: STRIPE (SERVER-SIDE ONLY)
# -------------------------------------------------------------------------
# [Private, Optional alternative gateway]
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -------------------------------------------------------------------------
# 6. STORAGE & MEDIA PERSISTENCE
# -------------------------------------------------------------------------
# [Public / Private, Optional]
STORAGE_CDN_URL=/uploads

# -------------------------------------------------------------------------
# 7. SECURITY & SUPER ADMIN BOOTSTRAP
# -------------------------------------------------------------------------
# [Private, Mandatory on initial production bootstrap]
FENIXCMS_BOOTSTRAP_ADMIN_EMAIL=admin@fenixcms.com
FENIXCMS_BOOTSTRAP_ADMIN_PASSWORD=

# -------------------------------------------------------------------------
# 8. DEVELOPMENT SIMULATION FLAGS (NEVER IN PRODUCTION)
# -------------------------------------------------------------------------
# [Private, Development Only, Optional]
ALLOW_DEV_TENANT_SIMULATION=false
