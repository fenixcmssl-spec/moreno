# =========================================================================
# FENIXCMS SAAS — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE (.env.example)
# =========================================================================
# Copy this file to .env or .env.production on your VPS server.
# Fill each variable with your actual production secrets and connection parameters.
# NEVER commit real credentials or secret keys to version control.
# =========================================================================

# -------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME & SERVER
# -------------------------------------------------------------------------
# NODE_ENV: Set to 'production' on your VPS server
NODE_ENV=production

# PORT: The port your Next.js application will listen on (default: 3000)
PORT=3000

# APP_URL: The primary canonical URL for the SaaS platform (used for redirects & callbacks)
APP_URL=https://fenixcms.com

# -------------------------------------------------------------------------
# 2. PERSISTENCE & DATABASE (POSTGRESQL + PRISMA)
# -------------------------------------------------------------------------
# DATABASE_URL: PostgreSQL connection string. Strict single source of truth.
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public&connection_limit=10
DATABASE_URL=postgresql://fenix_user:YOUR_SECURE_POSTGRES_PASSWORD@localhost:5432/fenixcms_prod?schema=public&connection_limit=10

# -------------------------------------------------------------------------
# 3. PAYMENT GATEWAY: STRIPE (SERVER-SIDE ONLY)
# -------------------------------------------------------------------------
# STRIPE_SECRET_KEY: Stripe Secret API Key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_development

# STRIPE_WEBHOOK_SECRET: Webhook Signing Secret for HMAC-SHA256 signature verification (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_placeholder_signing_secret_for_webhooks

# -------------------------------------------------------------------------
# 4. PAYMENT GATEWAY: PAYPAL REST API (SERVER-SIDE ONLY)
# -------------------------------------------------------------------------
# PAYPAL_CLIENT_ID: PayPal REST Client ID
PAYPAL_CLIENT_ID=your_paypal_client_id_placeholder

# PAYPAL_CLIENT_SECRET: PayPal REST Secret
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_placeholder

# PAYPAL_WEBHOOK_ID: PayPal Webhook Event ID registered in PayPal Developer Dashboard
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_placeholder

# -------------------------------------------------------------------------
# 5. STORAGE & CDN ASSETS
# -------------------------------------------------------------------------
# STORAGE_CDN_URL: Base URL for serving media assets (local uploads path or S3/R2 CDN URL)
STORAGE_CDN_URL=/uploads

# S3 / R2 / Object Storage Configuration (Optional for cloud object storage)
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=fenixcms-media-prod
# S3_ACCESS_KEY_ID=your_storage_access_key
# S3_SECRET_ACCESS_KEY=your_storage_secret_key

# -------------------------------------------------------------------------
# 6. AI CAPABILITIES (SERVER-SIDE ONLY)
# -------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key for server-side AI generation features
GEMINI_API_KEY=your_gemini_api_key_placeholder
