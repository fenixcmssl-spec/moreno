# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://fenix_admin:TuPasswordSeguro@localhost:5432/fenixcms_db?schema=public&connection_limit=10"

# =========================================================================
# STRIPE WEBHOOK & PAYMENT GATEWAY (PASO 12 - Webhook Security)
# =========================================================================
# STRIPE_SECRET_KEY: Clave secreta de la API de Stripe para cobros de licencias/suscripciones
STRIPE_SECRET_KEY="sk_test_51...your_stripe_secret_key"
# STRIPE_WEBHOOK_SECRET: Secreto de firma del endpoint webhook (ej. whsec_...) para verificación HMAC-SHA256
STRIPE_WEBHOOK_SECRET="whsec_...your_stripe_webhook_signing_secret"

# =========================================================================
# PAYPAL WEBHOOK & PAYMENT GATEWAY (PASO 12 - Webhook Security)
# =========================================================================
# PAYPAL_CLIENT_ID: Identificador de cliente de la aplicación PayPal REST
PAYPAL_CLIENT_ID="your_paypal_client_id"
# PAYPAL_CLIENT_SECRET: Secreto de la aplicación PayPal REST
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
# PAYPAL_WEBHOOK_ID: ID del webhook registrado en el panel de desarrolladores de PayPal
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id"
